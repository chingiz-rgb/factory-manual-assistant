# Copy to .env.local and change what you need. .env.local is git-ignored.

# "ollama" (free, local) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only needed when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# MANUALS_DIR=manuals
# DATA_DIR=.data/pglite
# TOP_K=5
